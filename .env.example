# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Toggle between 'chroma' (local persistent disk) or 'pinecone' (cloud serverless)
VECTOR_DB_TYPE=chroma

# Toggle between 'redis' (RediSearch full-text) or 'ram' (local pickle cache)
LEXICAL_DB_TYPE=redis

# Redis Configuration (required if LEXICAL_DB_TYPE=redis)
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=50

# Pinecone Configuration (required if VECTOR_DB_TYPE=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=insurance-rag-index

# ==============================================================================
# INFERENCE & MODEL PROVIDERS
# ==============================================================================
# Primary inference provider: "gemini" or "groq"
INFERENCE_PROVIDER=gemini

# API Keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Model Identifiers
EMBED_MODEL_NAME=BAAI/bge-large-en-v1.5
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
LLM_MODEL_NAME=gemini-3-flash-preview
PLANNER_LLM_MODEL_NAME=gemini-3.1-flash-lite

# Device for Hugging Face sentence transformers: "cpu" or "cuda"
HF_DEVICE=cpu

# ==============================================================================
# RETRIEVAL & INGESTION PARAMETERS
# ==============================================================================
DEFAULT_RETRIEVE_TOP_K=15
DEFAULT_RERANK_TOP_K=5
DEFAULT_SEMANTIC_WEIGHT=0.5
DEFAULT_LEXICAL_WEIGHT=0.5

CHUNK_SIZE=2000
CHUNK_OVERLAP=300
MAX_HISTORY_MESSAGES=6
ADMIN_PASSWORD=admin123

# ==============================================================================
# OBSERVABILITY & TRACING (Optional)
# ==============================================================================
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insurance-rag
