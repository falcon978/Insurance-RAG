FROM python:3.12-slim

# Prevent Python from writing pyc files and keep stdout/stderr unbuffered
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1

# Copy uv from the official image for lightning-fast builds
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy configuration files first to leverage Docker layer caching
COPY pyproject.toml README.md ./

# Install only the UI dependencies via pyproject.toml optional groups. Avoid editable (-e) for prod.
RUN uv pip install --no-cache .[ui]

# Copy the UI code (app.py)
COPY app.py ./

# Create a non-root user and switch to it for security best practices
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Expose Streamlit port
EXPOSE 8501

# Run the Streamlit UI
CMD ["streamlit", "run", "app.py", "--server.port", "8501", "--server.address", "0.0.0.0"]
