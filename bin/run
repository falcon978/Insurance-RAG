#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

echo "Starting deployment pre-flight checks..."

# (Optional) You could add a command here to ping Upstash Redis 
# or Pinecone to ensure they are reachable before booting the server.

# Calculate workers based on CPU cores (standard formula: 2 * cores + 1)
# Fallback to 2 workers if nproc is unavailable
CORES=$(nproc 2>/dev/null || echo 1)
WORKERS=$(( CORES * 2 + 1 ))

echo "Booting FastAPI Application via Uvicorn..."
echo "Allocating $WORKERS workers for optimal concurrency."

# Start the server
exec uvicorn main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers $WORKERS \
    --proxy-headers \
    --forwarded-allow-ips="*"